diff --git a/patches/mpv-keep-audio-session.patch b/patches/mpv-keep-audio-session.patch
new file mode 100644
index 0000000..49c31c3
--- /dev/null
+++ b/patches/mpv-keep-audio-session.patch
@@ -0,0 +1,17 @@
+--- a/audio/out/ao_audiounit.m	2026-09-25 08:45:48
++++ b/audio/out/ao_audiounit.m	2026-09-25 08:45:48
+@@ -230,10 +230,10 @@
+     AudioUnitUninitialize(p->audio_unit);
+     AudioComponentInstanceDispose(p->audio_unit);
+ 
+-    [AVAudioSession.sharedInstance
+-        setActive:NO
+-        withOptions:AVAudioSessionSetActiveOptionNotifyOthersOnDeactivation
+-        error:nil];
++    // Crocuta: la sessione audio e' una sola per tutta l'app, e con piu'
++    // player (AutoMix) chiudere l'uscita di uno la disattivava mentre gli
++    // altri suonavano, avvisando pure il sistema: CarPlay rispondeva con
++    // una pausa. Un'app musicale non rilascia la sessione mentre suona.
+ }
+ 
+ static int init(struct ao *ao)
