diff --git a/compat/sincosf.h b/compat/sincosf.h
new file mode 100644
index 0000000..4db1c6d
--- /dev/null
+++ b/compat/sincosf.h
@@ -0,0 +1,6 @@
+/* Xcode 26: math.h non dichiara piu' sincosf, ma solo __sincosf, e
+ * harfbuzz 8.1 la usa quando meson la trova in libm. */
+#if defined(__APPLE__) && defined(__cplusplus)
+#include <math.h>
+static inline void sincosf(float x, float *s, float *c) { __sincosf(x, s, c); }
+#endif
