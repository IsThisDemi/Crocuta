diff --git a/scripts/mbedtls/build.sh b/scripts/mbedtls/build.sh
index 05efd94..f90196e 100644
--- a/scripts/mbedtls/build.sh
+++ b/scripts/mbedtls/build.sh
@@ -22,6 +22,13 @@ cp -R subprojects/mbedtls/include/mbedtls/*.h dist/include/mbedtls
 cp -R subprojects/mbedtls/include/psa/*.h dist/include/psa
 ## install libs
 find . -type f -name '*.dylib' -exec sh -c 'mv {} dist/lib' \;
+## cmake 4: il file vero e' libmbedtls.19.dylib e libmbedtls.dylib e' solo un
+## collegamento, che il find sopra non sposta. Senza, il linker non trova
+## -lmbedtls e ffmpeg dice "mbedTLS not found".
+for LIB in dist/lib/lib*.[0-9]*.dylib; do
+    BASE=$(basename "$LIB" | sed -E 's/\.[0-9]+\.dylib$/.dylib/')
+    [ -e "dist/lib/$BASE" ] || ln -s "$(basename "$LIB")" "dist/lib/$BASE"
+done
 ## install pkgconfig file
 cp ${PROJECT_DIR}/scripts/mbedtls/mbedtls.pc.in dist/lib/pkgconfig/mbedtls.pc
 sed -i '' 's|${PREFIX}|'${OUTPUT_DIR}'|g' dist/lib/pkgconfig/mbedtls.pc
